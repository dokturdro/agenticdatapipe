BIKE_FEED_URL=https://gbfs.citibikenyc.com/gbfs/2.3/gbfs.json
BIKE_SYSTEM_ID=citibike-nyc
BIKE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BIKE_KAFKA_TOPIC=bike.station_status.v1
BIKE_KAFKA_GROUP_ID=bike-pipeline-v1
BIKE_DATA_DIR=data
BIKE_BATCH_SIZE=1000
BIKE_BATCH_TIMEOUT_SECONDS=30
BIKE_POLL_SECONDS=60
BIKE_METADATA_REFRESH_SECONDS=3600
BIKE_STALE_SECONDS=900
BIKE_REPAIR_LIMIT=2
BIKE_HTTP_TIMEOUT_SECONDS=20
BIKE_OPENAI_MODEL=gpt-4.1-mini
BIKE_FIXTURE_MODE=false
BIKE_STORAGE_BACKEND=local
BIKE_S3_ENDPOINT=http://localhost:9000
BIKE_S3_BUCKET=bike-lake
BIKE_S3_REGION=us-east-1
BIKE_S3_ACCESS_KEY_ID=minioadmin
BIKE_S3_SECRET_ACCESS_KEY=minioadmin
BIKE_S3_ALLOW_HTTP=true
BIKE_OBSERVATIONS_TABLE=delta/station_observations
BIKE_FEATURES_TABLE=delta/station_features
BIKE_RAW_PREFIX=raw/gbfs
BIKE_AUDIT_PREFIX=audit/runs
BIKE_FEAST_REPO_PATH=feature_repo
BIKE_FEAST_HISTORY_PATH=data/feast/station_features_history.parquet
BIKE_FEAST_REGISTRY_PATH=data/feast/registry.db
BIKE_FEAST_REDIS_CONNECTION=localhost:6379
BIKE_MLFLOW_TRACKING_URI=http://localhost:5000
BIKE_MLFLOW_EXPERIMENT=bike-availability-training
BIKE_MLFLOW_MODEL_NAME=bike-availability-15m
BIKE_MLFLOW_MODEL_ALIAS=champion
BIKE_FEAST_FEATURE_SERVICE=bike_availability_service
BIKE_API_PORT=8000
BIKE_SYNTHETIC_HISTORY_DAYS=30
BIKE_SYNTHETIC_STATION_COUNT=8
BIKE_SYNTHETIC_SEED=42
OPENAI_API_KEY=

# Compose-only local service settings
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW_JWT_SECRET=local-development-jwt-secret-change-me
